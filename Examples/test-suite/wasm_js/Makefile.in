# Experimental WebAssembly JavaScript tests.
srcdir = @srcdir@
top_builddir = @top_builddir@
SWIG = $(top_builddir)/preinst-swig
EMCXX = em++
NODE = node
TSC = tsc
EMCXXFLAGS = -O0 -fwasm-exceptions
TEST_CASES = basic constructor_handle director overload

.PHONY: check unsupported clean distclean
check: $(TEST_CASES:=.cpptest) unsupported

%.cpptest:
	$(SWIG) -c++ -wasm-js -stubs -o $*_wrap.cxx $(srcdir)/$*.i
	$(EMCXX) $(EMCXXFLAGS) -lembind $*_wrap.cxx -sMODULARIZE=1 -sEXPORT_NAME=createWasm -sEXPORTED_RUNTIME_METHODS='["UTF8ToString","lengthBytesUTF8","stringToUTF8"]' -sEXPORTED_FUNCTIONS=@$*_wrap.cxx.exports -o $*_wrap_wasm.js
	cp $(srcdir)/$*_runme.js $*_test.js
	$(NODE) $*_test.js
	cp $(srcdir)/$*_types.ts $*_test.ts
	$(TSC) --noEmit --strict --target ES2020 --module commonjs $*_test.ts

clean:
	rm -f *_wrap* *_test.js *_test.ts unsupported_*.cxx* unsupported_*.js unsupported_*.log

distclean: clean
	rm -f Makefile

unsupported:
	@for name in global extend import; do \
	  if $(SWIG) -c++ -wasm-js -o unsupported_$$name.cxx $(srcdir)/unsupported_$$name.i >unsupported_$$name.log 2>&1; then \
	    cat unsupported_$$name.log; exit 1; \
	  fi; \
	  grep -q "is not supported by -wasm-js" unsupported_$$name.log || { cat unsupported_$$name.log; exit 1; }; \
	done
